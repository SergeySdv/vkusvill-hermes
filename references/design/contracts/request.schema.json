{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local VkusVill shopping request (not MCP inputSchema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "quantity",
          "unit"
        ],
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$"
          },
          "unit": {
            "enum": [
              "piece",
              "package",
              "kg",
              "g",
              "l",
              "ml"
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "hard_exclusions",
        "preferences"
      ],
      "properties": {
        "currency": {
          "const": "RUB"
        },
        "max_goods_total": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$"
        },
        "hard_exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
