{
  "vkusvill_orders_history": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 99999
      }
    }
  },
  "vkusvill_shops": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 99999
      },
      "id_region_filter": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 999999999
      },
      "id_city_filter": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 999999999
      },
      "id_subway_filter": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 999999999
      },
      "id_feature_filter": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 999999999
      }
    }
  },
  "vkusvill_products_search": {
    "type": "object",
    "properties": {
      "q": {
        "type": "string",
        "default": "",
        "minLength": 1,
        "maxLength": 255
      },
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 99999
      },
      "limit": {
        "type": "integer",
        "default": 10,
        "minimum": 1,
        "maximum": 10
      },
      "category_id": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 999999
      },
      "sort": {
        "type": "string",
        "default": "popularity",
        "enum": [
          "price_asc",
          "price_desc",
          "rating",
          "popularity",
          "new"
        ]
      },
      "vvonly": {
        "type": "integer",
        "default": 1,
        "minimum": 0,
        "maximum": 1
      },
      "mode": {
        "type": "string",
        "default": "short",
        "enum": [
          "full",
          "short",
          "custom"
        ]
      },
      "fields": {
        "type": "array",
        "default": [],
        "items": {
          "type": "string",
          "enum": [
            "id",
            "xml_id",
            "name",
            "slug",
            "description",
            "price",
            "unit",
            "weight",
            "rating",
            "url",
            "images",
            "category",
            "properties"
          ]
        },
        "minItems": 0
      }
    }
  },
  "vkusvill_product_details": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999999999
      }
    },
    "required": [
      "id"
    ]
  },
  "vkusvill_product_barcode": {
    "type": "object",
    "properties": {
      "barcode": {
        "type": "string",
        "pattern": "^\\d{13}$"
      }
    },
    "required": [
      "barcode"
    ]
  },
  "vkusvill_product_analogs": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999999999
      }
    },
    "required": [
      "id"
    ]
  },
  "vkusvill_cart_link_create": {
    "type": "object",
    "properties": {
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "xml_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999999
            },
            "q": {
              "type": "number",
              "format": "float",
              "minimum": 0.01,
              "maximum": 40
            }
          }
        },
        "maxItems": 30
      }
    },
    "required": [
      "products"
    ]
  },
  "vkusvill_products_discount": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "default": "card",
        "enum": [
          "card",
          "quantity"
        ]
      },
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 99999
      },
      "sort": {
        "type": "string",
        "default": "popularity",
        "enum": [
          "price_asc",
          "price_desc",
          "rating",
          "popularity",
          "new",
          "name_asc",
          "name_desc"
        ]
      },
      "vvonly": {
        "type": "integer",
        "default": 1,
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "vkusvill_product_lp": {
    "type": "object",
    "properties": {}
  },
  "vkusvill_recipes": {
    "type": "object",
    "properties": {
      "sort": {
        "type": "string",
        "enum": [
          "popularity",
          "new"
        ]
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99999
      },
      "q": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "id_feature_filter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "id_cooking_time_filter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "id_cooking_method_filter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "id_complexity_filter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "id_category_filter": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999999
      },
      "id_exclude_allergens_filter": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        }
      }
    },
    "required": [
      "sort",
      "page",
      "q",
      "id_feature_filter",
      "id_cooking_time_filter",
      "id_cooking_method_filter",
      "id_complexity_filter",
      "id_category_filter",
      "id_exclude_allergens_filter"
    ]
  }
}
